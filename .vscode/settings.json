{
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.inlineSuggest.enable": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "cSpell.words": [
        "filthyrat",
        "mnemonist",
        "sdsl"
    ]
}